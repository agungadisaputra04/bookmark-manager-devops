# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://bookmark_user:bookmark_pass@localhost:5432/bookmark_manager
PGSSL=false

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1h

# --- Worker ---
LINK_CHECK_CRON=*/15 * * * *
LINK_CHECK_TIMEOUT_MS=5000
LINK_CHECK_CONCURRENCY=5
